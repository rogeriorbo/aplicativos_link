{
  "entities": {
    "User": {
      "title": "User",
      "description": "Application user account",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "nickname": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["master", "admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "email", "nickname", "role", "createdAt"]
    },
    "App": {
      "title": "App",
      "description": "Application link item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "url": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 1000 },
        "iconUrl": { "type": "string", "maxLength": 1000 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["app", "youtube_video"] },
        "category": { "type": "string", "maxLength": 100 },
        "isPinned": { "type": "boolean" }
      },
      "required": ["id", "name", "url", "ownerId"]
    },
    "Ticket": {
      "title": "Ticket",
      "description": "IT Support Ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ticketNumber": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "category": { "type": "string", "maxLength": 100 },
        "priority": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "department": { "type": "string", "maxLength": 100 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorNickname": { "type": "string", "maxLength": 100 },
        "creatorEmail": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "ticketNumber", "title", "description", "creatorId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/apps/{appId}": {
      "schema": { "$ref": "App" },
      "description": "Application links"
    },
    "/tickets/{ticketId}": {
      "schema": { "$ref": "Ticket" },
      "description": "Support tickets"
    }
  }
}
