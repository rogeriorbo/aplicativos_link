rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId);
      allow delete: if isSignedIn();
    }

    match /apps/{appId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && isValidId(appId);
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(ticketId);
    }
  }
}
